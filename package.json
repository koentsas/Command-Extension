{
    "name": "extension-launcher",
    "displayName": "Extension Launcher",
    "description": "Run configured VS Code commands for files by extension.",
    "version": "0.0.1",
    "publisher": "your-publisher-name",
    "keywords": [
        "command",
        "launcher",
        "files",
        "automation",
        "quickpick",
        "workflow"
    ],
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "icon": "media/icon.png",
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "extension-launcher.ping",
                "title": "Ping",
                "category": "Extension Launcher"
            },
            {
                "command": "extension-launcher.run",
                "title": "Run",
                "category": "Extension Launcher"
            }
        ],
        "configuration": {
            "title": "Extension Launcher",
            "properties": {
                "extensionLauncher.mappings": {
                    "type": "array",
                    "default": [],
                    "markdownDescription": "Mappings used by **Extension Launcher: Run**. Each item defines the visible title, file extension, command id, and optional commandArgs token template.",
                    "items": {
                        "type": "object",
                        "required": [
                            "title",
                            "extension",
                            "command"
                        ],
                        "properties": {
                            "title": {
                                "type": "string",
                                "description": "Title shown in the first quick pick."
                            },
                            "extension": {
                                "type": "string",
                                "description": "File extension to search for, with or without leading dot."
                            },
                            "command": {
                                "type": "string",
                                "description": "VS Code command id to execute after selecting a file."
                            },
                            "commandArgs": {
                                "type": "array",
                                "description": "Optional command arguments. If omitted, the selected file Uri is passed as the first argument.",
                                "items": {
                                    "type": [
                                        "string",
                                        "number",
                                        "boolean",
                                        "object",
                                        "array",
                                        "null"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "scripts": {
        "build": "node esbuild.js",
        "watch": "node esbuild.js --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src --ext .ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write .",
        "check-format": "prettier --check .",
        "vscode:prepublish": "npm run lint && npm run typecheck && npm run test && npm run build",
        "package:vsix": "vsce package",
        "publish:vsce": "vsce publish"
    },
    "devDependencies": {
        "@types/node": "^20.14.9",
        "@types/vscode": "^1.90.0",
        "@typescript-eslint/eslint-plugin": "^8.32.0",
        "@typescript-eslint/parser": "^8.32.0",
        "@vscode/vsce": "^3.2.1",
        "esbuild": "^0.25.5",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-prettier": "^5.4.0",
        "prettier": "^3.5.3",
        "typescript": "^5.8.3",
        "vitest": "^2.1.9"
    }
}